{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "the-digital-shelf",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "the-digital-shelf"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "edb50ec6709444e89e49d3e3105600ae"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SCAN_QUEUE",
        "queue": "digital-shelf-scan"
      }
    ],
    "consumers": [
      {
        "queue": "digital-shelf-scan",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 90,
        "retry_delay": 15
      }
    ]
  }
}
