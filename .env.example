# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (server + browser). NEVER expose SERVICE_ROLE_KEY to the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Session / CSRF
SESSION_SECRET=replace-with-32-byte-random-hex-generated-with-openssl-rand-hex-32

# Supabase Storage (private bucket for product files; create with `npm run db:bucket`)
# Defaults to product-files when omitted.
SUPABASE_STORAGE_BUCKET=product-files

# VirusTotal (optional for boot; required for upload malware scanning)
VT_FILESCAN_API_KEY=YOUR_VIRUSTOTAL_API_KEY
VT_POLL_INTERVAL_SECONDS=15
VT_MAX_POLL_ATTEMPTS=80

# Stripe (optional for boot; required for checkout/payments/connect)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_ME
STRIPE_PLATFORM_ACCOUNT_ID=acct_REPLACE_ME

# Local-only: passwords for `npm run db:accounts` (min 12 chars). Never deploy these.
ADMIN_PASSWORD=replace-with-your-chosen-admin-password
TEST_PASSWORD=replace-with-your-chosen-test-password

# Limits / business rules (all overridable in `settings` table)
MAX_UPLOAD_BYTES=26214400
MAX_PRODUCTS_PER_SELLER=25
MAX_PLATFORM_PRODUCTS=5000
SESSION_MAX_AGE_SECONDS=604800
DOWNLOAD_URL_TTL_SECONDS=600

# Email (add your provider; used for password reset + notifications)
EMAIL_FROM=no-reply@example.com
SMTP_URL=smtp://user:password@host:587
